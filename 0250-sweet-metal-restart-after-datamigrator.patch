+static bool sweet_process_running(const char *prefix)
+{
+ const size_t n=strlen(prefix);
+ for(int pid=1;pid<99999;pid++) {
+  proc_t p=proc_find(pid);
+  if(!p)continue;
+  const bool match=!strncmp(proc_best_name(p),prefix,n);
+  proc_rele(p);
+  if(match)return true;
+ }
+ return false;
+}
+static void sweet_restart_ui_for_metal(void)
+{
+ bool killed_backboardd=false;
+ for(int pid=1;pid<99999;pid++) {
+  proc_t p=proc_find(pid);
+  if(!p)continue;
+  const bool match=!strcmp(proc_best_name(p),"backboardd");
+  if(match)proc_signal(pid,SIGKILL);
+  proc_rele(p);
+  if(match) {
+   IOLog("SWEET RENDER: restarted backboardd for Metal discovery\n");
+   killed_backboardd=true;
+   break;
+  }
+ }
+ /* SpringBoard may be blocked in its synchronous BKSSystemShellService check-in with the
+    backboardd that was just killed; restart it together with backboardd (sweetsbrestart=0
+    turns this off). launchd respawns both. */
+ int sbrestart=1;PE_parse_boot_argn("sweetsbrestart",&sbrestart,sizeof(sbrestart));
+ if(killed_backboardd && sbrestart==1) {
+  for(int pid=1;pid<99999;pid++) {
+   proc_t p=proc_find(pid);
+   if(!p)continue;
+   const bool match=!strcmp(proc_best_name(p),"SpringBoard");
+   if(match)proc_signal(pid,SIGKILL);
+   proc_rele(p);
+   if(match) {
+    IOLog("SWEET RENDER: restarted SpringBoard after backboardd\n");
+    break;
+   }
+  }
+ }
+}
+static void sweet_metal_restart_thread(void *arg,wait_result_t result)
+{
+ (void)arg;(void)result;
+ int dmwait=5400;PE_parse_boot_argn("sweetm2dmwait",&dmwait,sizeof(dmwait));
+ int waited=0;bool announced=false;
+ while(waited<dmwait && sweet_process_running("com.apple.datami")) {
+  if(!announced) {
+   IOLog("SWEET RENDER: data migration is running; the Metal restart of backboardd waits for it (up to %d s, sweetm2dmwait)\n",dmwait);
+   announced=true;
+  }
+  IOSleep(5000);
+  waited+=5;
+ }
+ if(announced)IOLog("SWEET RENDER: datamigrator gone after %d s; restarting backboardd now\n",waited);
+ sweet_restart_ui_for_metal();
+ for(;;)IOSleep(3600000);   /* one-shot thread; parked instead of terminated */
+}
